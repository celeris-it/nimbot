{
  "name": "nimbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @nimbot/panel build && pnpm --filter @nimbot/server build && pnpm --filter @nimbot/agent-host build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "start:server": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "panel:password": "node apps/server/dist/password.js",
    "dev:panel": "pnpm --filter @nimbot/panel dev",
    "test:panel": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
