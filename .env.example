# Generate with pnpm build && pnpm panel:password. Never put a plaintext password here.
PANEL_PASSWORD_HASH=
# Public origin used to validate form submissions. Remote access requires HTTPS.
PANEL_URL=http://localhost:3000
PANEL_HOST=127.0.0.1
PANEL_PORT=3000

# SQLite state directory for native server runs; Compose uses its own named volume.
SERVER_STATE_DIR=.nimbot

# Trusted deployment settings for panel-managed agent provisioning.
# Only the server receives the Docker socket; this grants host-level Docker control.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Linux: stat -L -c '%g' /var/run/docker.sock
# macOS (Docker Desktop): stat -L -f '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=0
# Immutable ID: docker image inspect nimbot-agent-host --format '{{.Id}}'
AGENT_HOST_IMAGE=
SERVER_CONTAINER_NAME=nimbot-server

# Maximum run time of one task, in seconds (default 600).
TASK_TIMEOUT_SECONDS=600
