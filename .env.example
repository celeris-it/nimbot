# Native development: pnpm dev loads this file and selects native mode.
# Docker: the image supplies its bind address, data directory and deployment mode.
# Generate a hash with pnpm panel:password or the image's password command.
PANEL_PASSWORD_HASH=
PANEL_URL=http://localhost:3000
TASK_TIMEOUT_SECONDS=600

# Optional native settings. Leave unset in Docker to use the image defaults.
# PANEL_HOST=127.0.0.1
# PANEL_PORT=3000
# SERVER_STATE_DIR=.nimbot-native
# Shared Chromium binaries; pnpm dev detects the usual user cache by default.
# PLAYWRIGHT_BROWSERS_PATH=
