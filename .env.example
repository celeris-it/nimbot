# Obtain a bot token from Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. An empty allowlist prevents startup.
TELEGRAM_ALLOWED_USER_IDS=

# Generate with pnpm build && pnpm panel:password. Never put a plaintext password here.
PANEL_PASSWORD_HASH=
# Public origin used to validate form submissions. Remote access requires HTTPS.
PANEL_URL=http://localhost:3000
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
