# Obtain a bot token from Telegram's @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. An empty allowlist prevents startup.
TELEGRAM_ALLOWED_USER_IDS=

# Generate with pnpm build && pnpm panel:password. Never put a plaintext password here.
PANEL_PASSWORD_HASH=
# Public origin used to validate form submissions. Remote access requires HTTPS.
PANEL_URL=http://localhost:3000
PANEL_HOST=127.0.0.1
PANEL_PORT=3000

# Single pre-configured agent. Blank owner uses the sole allowlisted user;
# if several users are allowed, an explicit owner is required.
AGENT_ID=default
AGENT_NAME=Agente
TELEGRAM_OWNER_USER_ID=

# Internal Agent Host API key. Generate with: openssl rand -hex 32
# This is separate from Telegram, panel, and AI provider credentials.
AGENT_HOST_TOKEN=

# Internal API origin; Compose sets this automatically.
AGENT_HOST_URL=http://agent-host:3001

# SQLite state directory for native server runs; Compose uses its own named volume.
SERVER_STATE_DIR=.nimbot

# Optional Docker container controls. Leave both blank to keep them disabled.
DOCKER_SOCKET_PATH=
AGENT_CONTAINER_NAME=
# For compose.docker.yaml: numeric group that can access the host Docker socket.
DOCKER_SOCKET_GID=
